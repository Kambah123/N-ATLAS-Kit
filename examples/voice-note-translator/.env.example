# Copy to the repo-root .env or export these in your shell.
# Never commit real values. .env is git-ignored; this example file is not a secret.

# Gateway origin, with or without /v1.
# Demo (scales to zero, cold start on the first call):
#   https://kambah123--natlas-serve-natlasservice-serve.modal.run
NATLAS_BASE_URL=

# One of the Bearer keys in the gateway's NATLAS_API_KEYS / Modal secret natlas-api.
# This repository does not publish that key.
NATLAS_API_KEY=

# Local web UI only. Binds to 127.0.0.1.
NATLAS_EXAMPLE_PORT=8787
