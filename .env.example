# =============================================================================
# N-ATLAS Kit - example environment file
# =============================================================================
# Copy to `.env` and fill in real values. `.env` is git-ignored.
#   cp .env.example .env
#
# NEVER commit real keys. Every secret below is read from the environment only.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Client configuration (SDKs, playground, examples)
# -----------------------------------------------------------------------------

# Base URL of an N-ATLaS-compatible endpoint (no trailing slash).
# This is the gateway from /serve, or later the official NCAIR API.
# There is NO public hosted N-ATLaS API yet - you must run /serve yourself.
NATLAS_BASE_URL=http://localhost:8080/v1

# Bearer token sent as `Authorization: Bearer <key>`.
# For self-hosting this is whatever you set in NATLAS_API_KEYS below.
NATLAS_API_KEY=

# Which backend adapter the SDK should use.
#   openai-compatible  -> /serve, vLLM, or any OpenAI-shaped endpoint (default)
#   hf-endpoint        -> a Hugging Face Inference Endpoint running N-ATLaS
#   official           -> the official NCAIR N-ATLaS API (not public yet)
NATLAS_BACKEND=openai-compatible

# Model id advertised by the endpoint.
NATLAS_MODEL=NCAIR1/N-ATLaS

# Optional client tuning
NATLAS_TIMEOUT_MS=60000
NATLAS_MAX_RETRIES=2


# -----------------------------------------------------------------------------
# 2. Self-hosting kit (/serve)
# -----------------------------------------------------------------------------

# Hugging Face token. REQUIRED: every NCAIR1 model is gated ("agree to share
# your contact information"). Accept the terms on each model page with the same
# HF account, then create a read token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Comma-separated list of API keys the gateway will accept.
# Generate one with:  openssl rand -hex 32
NATLAS_API_KEYS=

# Models served by /serve (see docs/n-atlas-integration.md)
NATLAS_LLM_MODEL=NCAIR1/N-ATLaS
NATLAS_ASR_MODEL_HA=NCAIR1/Hausa-ASR
NATLAS_ASR_MODEL_IG=NCAIR1/Igbo-ASR
NATLAS_ASR_MODEL_YO=NCAIR1/Yoruba-ASR
NATLAS_ASR_MODEL_EN=NCAIR1/NigerianAccentedEnglish

# Internal upstreams the gateway proxies to.
# NATLAS_ASR_MODE: `proxy` = ASR is a separate service at NATLAS_ASR_URL
# (docker-compose); `local` = ASR runs in-process (the Modal single container).
NATLAS_VLLM_URL=http://vllm:8000
NATLAS_ASR_MODE=proxy
NATLAS_ASR_URL=http://asr:8001

# vLLM tuning. N-ATLaS is a Llama-3 8B model; its card states 8,092 usable
# tokens of context even though max_position_embeddings is 131072.
# At 0.90 on a 24 GB card that leaves ~5.4 GiB of KV cache after the 15 GiB of
# BF16 weights. See serve/README.md for the full table.
NATLAS_VLLM_MAX_MODEL_LEN=8192
NATLAS_VLLM_GPU_MEMORY_UTILIZATION=0.90
# Any extra vLLM flags, parsed as a shell word list.
NATLAS_VLLM_EXTRA_ARGS=

# Speech-to-text. `cpu` by default on purpose: vLLM pre-allocates its KV cache
# from free VRAM, so a second CUDA process on the same card risks an OOM.
NATLAS_ASR_DEVICE=cpu
NATLAS_ASR_CHUNK_SECONDS=25

# CORS origins allowed by the gateway (comma-separated). Empty = no CORS
# headers, which is correct when only your own server calls the gateway.
NATLAS_CORS_ORIGINS=http://localhost:3000


# -----------------------------------------------------------------------------
# 3. Playground (/apps/playground) - server-side only, never NEXT_PUBLIC_*
# -----------------------------------------------------------------------------
# The playground calls N-ATLaS from Next.js route handlers so the key never
# reaches the browser. It reuses NATLAS_BASE_URL / NATLAS_API_KEY above.

# Anonymous usage counters (feature, language, latency - never user content).
# Leave blank to disable logging entirely.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# or Supabase instead of Vercel KV
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# 4. Release automation (CI secrets - set in GitHub, not here)
# -----------------------------------------------------------------------------
# NPM_TOKEN   -> publishes `n-atlas` to npm on a v* tag
# PYPI_TOKEN  -> publishes `natlas` to PyPI on a v* tag
