# =============================================================================
# N-ATLAS Playground — server environment
# =============================================================================
# Copy to apps/playground/.env.local for `pnpm dev`. On Vercel, set the same
# names in Project → Settings → Environment Variables.
#
# These are read only by Next.js route handlers. Do NOT prefix them with
# NEXT_PUBLIC_. The browser never receives the key or the upstream URL.
# =============================================================================

# Gateway origin from /serve (Modal, Docker, or a local gateway).
# Either form works:
#   https://your-app.modal.run
#   https://your-app.modal.run/v1
#   http://localhost:8080
NATLAS_BASE_URL=http://localhost:8080

# Bearer token. Must be one of the values in the gateway's NATLAS_API_KEYS.
NATLAS_API_KEY=

# Optional. How long the status probe waits before showing "waking up".
# A cold Modal container often will not answer /health inside a few seconds.
# NATLAS_HEALTH_TIMEOUT_MS=8000

# Optional. Chat and transcription budget. A scale-to-zero cold start can
# take 1–3 minutes, and Modal may answer with HTTP 303 while it warms.
# NATLAS_UPSTREAM_TIMEOUT_MS=180000
