# Keep the build context small and, more importantly, keep secrets out of it.
.env
.env.*
!.env.example

tests/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
**/__pycache__/
**/*.py[cod]

*.egg-info/
build/
dist/

# Modal deploys from source, not from this image.
modal_app.py
modal_preflight.py
MODAL_SETUP.md

# Never ship model weights or sample audio into an image layer.
*.safetensors
*.bin
*.gguf
*.wav
*.mp3
*.ogg
*.m4a
*.flac
