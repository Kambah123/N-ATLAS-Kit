# Copy to .env and fill in. .env is gitignored; never commit real values.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Hugging Face token. All five NCAIR1 repos are gated ("auto" approval), so the
# token must belong to an account that has visited each model page and accepted
# the N-ATLaS Terms of Use. Needs only `read` scope.
#   https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated Bearer tokens accepted by the gateway. Generate with:
#   openssl rand -hex 32
# The gateway refuses to start if this is empty (see NATLAS_ALLOW_ANONYMOUS).
NATLAS_API_KEYS=

# ---------------------------------------------------------------------------
# Optional - gateway
# ---------------------------------------------------------------------------

# Host port for the gateway.
# NATLAS_PORT=8080

# Browser origins allowed to call the gateway directly. Empty = no CORS headers,
# which is correct when only your own server talks to it.
# NATLAS_CORS_ORIGINS=http://localhost:3000,https://your-playground.vercel.app

# Seconds to wait on an upstream response. Long transcriptions need headroom.
# NATLAS_REQUEST_TIMEOUT=120

# Largest accepted audio upload, in bytes. Default 64 MiB.
# NATLAS_MAX_UPLOAD_BYTES=67108864

# DANGEROUS. Disables authentication entirely. Only for a throwaway local box
# that is not reachable from the network.
# NATLAS_ALLOW_ANONYMOUS=false

# ---------------------------------------------------------------------------
# Optional - model and vLLM
# ---------------------------------------------------------------------------

# Point at a fine-tune or a local mirror of the weights.
# NATLAS_LLM_MODEL=NCAIR1/N-ATLaS

# The model card states a usable context of 8,092 tokens even though
# max_position_embeddings is 131,072. Raising this makes vLLM reserve a KV
# cache that will not fit on a 24 GB card.
# NATLAS_VLLM_MAX_MODEL_LEN=8192

# Fraction of VRAM vLLM may claim. On a 24 GB card 0.90 leaves ~5 GB of KV
# cache after the 15 GB of BF16 weights - roughly five concurrent full-context
# conversations.
# NATLAS_VLLM_GPU_MEMORY_UTILIZATION=0.90

# Extra vLLM flags, parsed as a shell word list.
# NATLAS_VLLM_EXTRA_ARGS=--enable-prefix-caching --swap-space 8

# ---------------------------------------------------------------------------
# Optional - speech to text
# ---------------------------------------------------------------------------

# cpu | cuda | auto. Defaults to cpu so Whisper cannot compete with vLLM for
# VRAM. Use cuda only when ASR has a card to itself.
# NATLAS_ASR_DEVICE=cpu

# Target seconds per chunk for audio longer than Whisper's 30 s window. The
# splitter looks for a pause within +/-4 s of this target.
# NATLAS_ASR_CHUNK_SECONDS=25

# Override individual ASR models, e.g. to use your own fine-tune.
# NATLAS_ASR_MODEL_HA=NCAIR1/Hausa-ASR
# NATLAS_ASR_MODEL_IG=NCAIR1/Igbo-ASR
# NATLAS_ASR_MODEL_YO=NCAIR1/Yoruba-ASR
# NATLAS_ASR_MODEL_EN=NCAIR1/NigerianAccentedEnglish
